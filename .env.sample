NODE_ENV=development

# Root Outline-based frontend and Pet Store API origins.
URL=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3000
PET_STORE_API_URL=http://localhost:3000
CDN_URL=

# Required database connection for all Pet Store records.
DATABASE_URL=postgresql://user:password@localhost:5432/pet_store

# Optional locally. Configure both values together in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email. Production must use resend or kurir.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Petso <no-reply@example.com>
KURIR_BASE_URL=https://api-kurir.treonstudio.workers.dev
KURIR_API_KEY=
KURIR_PRODUCT_ID=

# Ember object storage. EMBER_API_KEY is required in production.
EMBER_BASE_URL=https://ember.treonstudio.com
EMBER_API_KEY=
EMBER_BUCKET=pet-store
STORAGE_PUBLIC_URL_BASE=

# Midtrans billing.
VITE_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Optional integrations.
ANIS_AI_API_KEY=
ANIS_AI_BASE_URL=https://api.anis.ai
MCP_SECRET_TOKEN=
MCP_BUSINESS_ID=

# Public appearance and analytics.
VITE_GA_ID=
VITE_OG_IMAGE_URL=
VITE_LOGIN_BG_URL=
VITE_SIGNUP_BG_URL=
