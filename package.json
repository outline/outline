{
  "name": "outline",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/@pet-store-app/*"
  ],
  "license": "Business Source License 1.1",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf build",
    "copy:i18n": "mkdir -p ./public/locales && for d in ./shared/i18n/locales/*; do if [ -f \"$d/translation.json\" ]; then lang=$(basename \"$d\"); cp \"$d/translation.json\" \"./public/locales/${lang}.json\"; fi; done",
    "build:i18n": "i18next --silent '{shared,app,plugins}/**/*.{ts,tsx}' && yarn copy:i18n",
    "build": "yarn pet:build",
    "dev": "yarn pet:dev",
    "agent": "npx tsx ./scripts/auto-agent.ts",
    "lint": "oxlint --type-aware app shared plugins",
    "lint:changed": "git diff --name-only --diff-filter=ACMRTUXB | grep -E '\\.(js|jsx|ts|tsx)$' | xargs -r oxlint",
    "format": "oxfmt app shared plugins",
    "format:check": "oxfmt --check app shared plugins",
    "prepare": "husky install",
    "postinstall": "yarn patch-package",
    "test": "TZ=UTC vitest run",
    "test:app": "TZ=UTC vitest run --project app",
    "test:shared": "TZ=UTC vitest run --project shared-jsdom",
    "test:watch": "TZ=UTC vitest",
    "vite:dev": "VITE_CJS_IGNORE_WARNING=true vite",
    "vite:build": "VITE_CJS_IGNORE_WARNING=true vite build",
    "vite:preview": "VITE_CJS_IGNORE_WARNING=true vite preview",
    "outline:build": "yarn clean && yarn vite:build && yarn build:i18n",
    "outline:dev": "VITE_CJS_IGNORE_WARNING=true vite",
    "outline:preview": "VITE_CJS_IGNORE_WARNING=true vite preview",
    "pet:dev": "yarn workspace @pet-store-app/web dev",
    "pet:build": "yarn workspace @pet-store-app/web build",
    "pet:preview": "yarn workspace @pet-store-app/web preview",
    "pet:typecheck": "yarn workspace @pet-store-app/web typecheck",
    "pet:test": "yarn workspace @pet-store-app/web test:unit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static"
  },
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/outline"
  },
