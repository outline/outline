ARG NODE_VERSION=26.12.1
FROM node:${NODE_VERSION}

WORKDIR /opt/outline
ENV NODE_OPTIONS="--max-old-space-size=8192"

RUN apt-get update && apt-get install -y cmake && rm -rf /var/lib/apt/lists/*
RUN npm install -g corepack && corepack enable

# Dependencies first so they stay cached until the lockfile changes
COPY ./package.json ./yarn.lock ./.yarnrc.yml ./
COPY ./patches ./patches
RUN yarn install --immutable --network-timeout 1000000

COPY . .

# Type check the whole project
RUN yarn tsc --noEmit

# Run the space-separated list of unit tests passed in by the release skill
ARG TEST_FILES=""
RUN if [ -n "$TEST_FILES" ]; then yarn test $TEST_FILES; else echo "No TEST_FILES given" && exit 1; fi
