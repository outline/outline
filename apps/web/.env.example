NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3000

# Required for database-backed features.
DATABASE_URL=postgresql://user:password@localhost:5432/pet_store

# Optional locally; production cache operations require both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email. Use console only for local development.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Pet Store <no-reply@example.com>

# Ember object storage.
EMBER_BASE_URL=https://ember.treonstudio.com
EMBER_API_KEY=
EMBER_BUCKET=pet-store
STORAGE_PUBLIC_URL_BASE=

# Midtrans server-side secret and browser-safe client key.
VITE_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Optional integrations.
KURIR_BASE_URL=https://api-kurir.treonstudio.workers.dev
KURIR_API_KEY=
KURIR_PRODUCT_ID=
ANIS_AI_API_KEY=
ANIS_AI_BASE_URL=https://api.anis.ai
MCP_SECRET_TOKEN=
MCP_BUSINESS_ID=

# Public appearance/analytics settings.
VITE_GA_ID=
VITE_OG_IMAGE_URL=
VITE_LOGIN_BG_URL=
VITE_SIGNUP_BG_URL=
