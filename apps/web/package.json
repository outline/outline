	"name": "@pet-store-app/web",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "npm run build && wrangler deploy",
		"dev": "vite dev",
		"build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
		"build:dev": "vite build --mode development",
		"preview": "vite preview",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:arch": "depcruise src --config .dependency-cruiser.cjs",
		"lint:arch:affected": "git diff --diff-filter=d --name-only HEAD | grep -E '\\.(ts|tsx)$' | xargs depcruise --config .dependency-cruiser.cjs || depcruise src --config .dependency-cruiser.cjs",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
